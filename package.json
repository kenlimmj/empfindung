{
  "name": "empfindung",
  "version": "1.0.1",
  "description": "Library for common CIE color difference measurements",
  "main": "dist/DeltaE.js",
  "files": [
    "dist"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "babel lib --out-dir dist",
    "test": "nyc ava -v",
    "report": "nyc report --reporter=html",
    "prepublishOnly": "npm run build && npm test"
  },
  "bugs": {
    "url": "https://github.com/kenlimmj/empfindung/issues"
  },
  "homepage": "https://github.com/kenlimmj/empfindung#readme",
  "keywords": [
    "color",
    "CIE",
    "Delta E",
    "CIELAB",
    "CIE76",
    "CIE94",
    "CIEDE2000",
    "CMC l:c (1984)",
    "MacAdam"
  ],
  "repository": "github:kenlimmj/empfindung",
  "author": "Lim Mingje, Kenneth <me@kenlimmj.com> (https://kenlimmj.com)",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@babel/plugin-transform-flow-strip-types": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/register": "^7.24.0",
    "ava": "^5.3.0",
    "eslint": "^8.57.0",
    "nyc": "^17.0.0"
  },
  "ava": {
    "files": [
      "tests/*.js"
    ],
    "timeout": "30s",
    "require": [
      "@babel/register"
    ]
  }
}
